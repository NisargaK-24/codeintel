# CodeIntel Configuration Environment Variables

# Scanner Settings
CODEINTEL_MAX_FILE_SIZE_BYTES=5242880
CODEINTEL_EXCLUDED_DIRS=.git,__pycache__,.venv,venv,node_modules,.tox,.idea,.vscode,build,dist,.pytest_cache
CODEINTEL_VERBOSE=false

# Code Quality Thresholds
CODEINTEL_MAX_FUNCTION_LENGTH=50
CODEINTEL_MAX_FUNCTION_PARAMS=5
CODEINTEL_MAX_CYCLOMATIC_COMPLEXITY=10
CODEINTEL_MAX_NESTING_DEPTH=4
CODEINTEL_MAX_CLASS_METHODS=15
CODEINTEL_MAX_CLASS_LENGTH=300

# Zombie Detection Settings
CODEINTEL_ZOMBIE_MIN_SCORE=50
CODEINTEL_ZOMBIE_AGE_DAYS_SUSPICIOUS=90

# Output Settings
CODEINTEL_OUTPUT_JSON=false
